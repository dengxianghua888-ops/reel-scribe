{
  "schema": "skill-registry/1",
  "routing": "agent-semantic; see router.md",
  "entries": [
    {
      "id": "audio-extract",
      "layer": "atomic",
      "entry": "atomic/audio-extract/SKILL.md",
      "description": "按指定源时间范围、采样率和声道数提取 PCM WAV；用于转写或音频处理前准备，不选择台词、不清除停顿。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "audio-mix",
      "layer": "atomic",
      "entry": "atomic/audio-mix/SKILL.md",
      "description": "将指定音频区间按明确时间位置和增益混入已有视频，保留原视频流；用于已确定的配音或配乐摆放，不选择音乐、不改写旁白、不自动裁短语音。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "caption-burn",
      "layer": "atomic",
      "entry": "atomic/caption-burn/SKILL.md",
      "description": "按明确输出时间、字体文件、字号、颜色和边距烧录给定字幕；不改文案、不选择关键词、不自动设计字幕风格。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "caption-map",
      "layer": "atomic",
      "entry": "atomic/caption-map/SKILL.md",
      "description": "将给定原文字幕按确定剪辑计划从源时间映射到输出时间，生成 JSON 与 SRT；不转写、不校正文案、不选择强调词。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "frame-extract",
      "layer": "atomic",
      "entry": "atomic/frame-extract/SKILL.md",
      "description": "按明确时间点从已登记视频抽取画面 PNG；用于建立观察证据，不自行寻找高光或判断最佳镜头。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "media-inspect",
      "layer": "atomic",
      "entry": "atomic/media-inspect/SKILL.md",
      "description": "读取指定本地音视频的时长、流规格和 SHA-256；用于登记素材或核对已有素材身份，不评价内容或选择素材。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "media-qc",
      "layer": "atomic",
      "entry": "atomic/media-qc/SKILL.md",
      "description": "对指定哈希的视频完整解码并检查显式要求的时长、宽高和音频流；用于技术交付检查，不评价故事、风格或听感。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "speech-plan-compile",
      "layer": "atomic",
      "entry": "atomic/speech-plan-compile/SKILL.md",
      "status": "local-synthetic-tested",
      "description": "将已明确选择的连续词 ID 和经上游复核的声学入出点编译为剪辑计划，检查保留词、保护词和被排除词的时间覆盖；不挑 take、不删口癖、不改原话。"
    },
    {
      "id": "timeline-patch",
      "layer": "atomic",
      "entry": "atomic/timeline-patch/SKILL.md",
      "description": "在校验当前计划版本后，修改明确指定片段的入点、出点、增益或恒定速度，保持其他片段数据；不解释审美反馈、不增删或重排片段。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "timeline-render",
      "layer": "atomic",
      "entry": "atomic/timeline-render/SKILL.md",
      "description": "按明确源区间、顺序、音量、恒定速度和输出规格渲染本地时间线预览；只执行已决定的片段表，不选段、不改节奏或生成旁白。",
      "status": "local-synthetic-tested"
    },
    {
      "id": "transcript-import",
      "layer": "atomic",
      "entry": "atomic/transcript-import/SKILL.md",
      "status": "local-synthetic-tested",
      "description": "校验并登记与当前源音视频哈希绑定的逐词转写，保留词 ID、说话人和时间来源；不执行识别、不纠词、不作删减判断。"
    },
    {
      "id": "tts-macos",
      "layer": "atomic",
      "entry": "atomic/tts-macos/SKILL.md",
      "description": "使用明确指定的 macOS 已安装语音、朗读速度和原文生成本地旁白 WAV；只负责合成，不写稿、不选音色、不伪造逐词时间。",
      "status": "local-synthetic-tested"
    },
