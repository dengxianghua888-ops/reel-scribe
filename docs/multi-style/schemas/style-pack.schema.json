{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reel-scribe/multi-style/style-pack/1",
  "title": "style-pack/1 风格包（草案）",
  "description": "可执行的风格主题：组合刻面，声明决策槽、绑定规则、能力需求、签名与克制、检查与返工单位。皮肤包用 extends 继承基础包。",
  "type": "object",
  "required": ["schema", "id", "name", "version", "status", "cost_tier", "routes", "workflow", "facets", "decision_slots", "checks", "provenance"],
  "properties": {
    "schema": {"const": "style-pack/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["authored", "authored-unvalidated", "authored-adhoc", "compiled", "previewed", "limited-trial", "validated", "deprecated"]},
    "extends": {"type": "string", "description": "基础包 id@version"},
    "abstract": {"type": "boolean", "description": "基础包不可直接选用"},
    "cost_tier": {"enum": ["base", "skin", "mechanism"]},
    "routes": {"type": "array", "minItems": 1, "items": {"enum": ["EDIT", "GENERATE", "HYBRID", "PLAN"]}},
    "workflow": {"type": "string", "description": "场景工作流 ID，如 raven-speech-edit"},
    "facets": {
      "type": "object",
      "properties": {
        "method": {"$ref": "#/$defs/ref"},
        "rhythm": {"$ref": "#/$defs/ref"},
        "design_system": {"$ref": "#/$defs/ref"},
        "components": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "caption_style": {"$ref": "#/$defs/ref"},
        "look": {"$ref": "#/$defs/ref"},
        "sound": {"$ref": "#/$defs/ref"},
        "generation": {"$ref": "#/$defs/ref"}
      },
      "additionalProperties": false
    },
    "fit": {
      "type": "object",
      "properties": {
        "signals": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
        "anti": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
        "requires_signals": {"type": "array", "items": {"type": "string"}},
        "requires_assets": {"type": "array", "items": {"type": "string"}},
        "goals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "capability_requirements": {
      "type": "object",
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "degrade"],
            "properties": {"capability": {"type": "string"}, "degrade": {"type": "string"}}
          }
        }
      }
    },
    "pipeline": {
      "type": "array",
      "description": "基础包声明的阶段顺序；皮肤包不得覆写",
      "items": {
        "type": "object",
        "required": ["stage", "ops"],
        "properties": {"stage": {"type": "string"}, "ops": {"type": "array", "items": {"type": "string"}}, "owner": {"enum": ["agent-semantic", "deterministic", "user"]}}
      }
    },
    "decision_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mode"],
        "properties": {
          "id": {"type": "string"},
          "mode": {"enum": ["locked", "runtime", "user"]},
          "owner": {"enum": ["agent-semantic", "deterministic", "user"]},
          "rule": {"type": "string"},
          "default": {}
        }
      }
    },
    "binding_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "on", "do", "priority"],
        "properties": {
          "id": {"type": "string"},
          "on": {
            "type": "object",
            "required": ["signal"],
            "properties": {"signal": {"type": "string"}, "where": {"type": "string"}, "min_confidence": {"type": "number"}}
          },
          "do": {
            "type": "object",
            "required": ["component"],
            "properties": {"component": {"type": "string"}, "props": {"type": "object"}}
          },
          "timing": {
            "type": "object",
            "properties": {"anchor": {"type": "string"}, "lead_ms": {"type": "integer"}, "min_hold_ms": {"type": "integer"}, "exit": {"type": "string"}}
          },
          "placement": {
            "type": "object",
            "properties": {"prefer": {"type": "array", "items": {"type": "string"}}, "avoid": {"type": "array", "items": {"type": "string"}}}
          },
          "density": {
            "type": "object",
            "properties": {"max_per_min": {"type": "number"}, "min_gap_ms": {"type": "integer"}, "max_total": {"type": "integer"}}
          },
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "fallback": {"type": "string"}
        }
      }
    },
    "segment_policy": {
      "type": "object",
      "description": "段落级路由时的全片不变量",
      "properties": {"invariants": {"type": "array", "items": {"enum": ["design_system", "caption_style", "look", "sound"]}}, "transition": {"type": "string"}}
    },
    "signature": {
      "type": "object",
      "required": ["device", "strength"],
      "properties": {"device": {"type": "string"}, "strength": {"type": "number", "minimum": 0, "maximum": 1}, "min_occurrences": {"type": "integer"}}
    },
    "restraint": {"type": "array", "items": {"type": "string"}},
    "cliche_blocklist": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"type": "string"}},
    "knobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["range", "default"],
        "properties": {"range": {"type": "array"}, "default": {}, "maps": {"type": "object"}}
      }
    },
    "editability": {
      "type": "object",
      "properties": {
        "rework_units": {"type": "array", "items": {"enum": ["cut", "caption-line", "component-instance", "design-system", "grade-layer", "audio-track", "generated-shot"]}},
        "notes": {"type": "string"}
      }
    },
    "vector": {
      "type": "object",
      "properties": {
        "tempo": {"type": "number"}, "density": {"type": "number"}, "ornament": {"type": "number"}, "warmth": {"type": "number"},
        "contrast": {"type": "number"}, "formality": {"type": "number"}, "motion": {"type": "number"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "description": "面向用户的入口卡信息",
      "properties": {
        "title": {"type": "string"},
        "one_liner": {"type": "string"},
        "sample": {"type": "string"},
        "input_roles": {"type": "array", "items": {"type": "object", "required": ["role", "label"], "properties": {"role": {"type": "string"}, "label": {"type": "string"}, "min": {"type": "integer"}, "max": {"type": "integer"}}}},
        "deliverable": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"type": "string"}, "inspired_by": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}}
    },
    "validation": {
      "type": "object",
      "properties": {
        "evidence": {"type": "array", "items": {"type": "object"}},
        "baseline_win_rate": {"type": "number"},
        "signature_recall": {"type": "number"}
      }
    }
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[a-z-]+/[a-z0-9-]+(/[a-z0-9-]+)?@\\d+\\.\\d+\\.\\d+$", "description": "kind/id@version，method 为 method/<domain>/<card-id>@version"},
    "predicate": {
      "type": "object",
      "required": ["signal", "op", "value", "weight"],
      "properties": {
        "signal": {"type": "string"},
        "op": {"enum": [">=", "<=", "==", "!=", "in", "count>=", "count<=", "exists"]},
        "value": {},
        "weight": {"type": "number", "minimum": -1, "maximum": 1},
        "why": {"type": "string"}
      }
    }
  }
}
